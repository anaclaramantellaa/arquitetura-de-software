    title Sistema de Vendas - Contêineres e Camadas

    Person(vendedor, "Vendedor")
    Person(admin, "Administrador")
    Person(estoque, "Time de Estoque")

    System_Boundary(sistema, "Sistema de Vendas") {

        Container(interface, "Interface", "Apresentação", "Telas utilizadas pelos usuários")

        Container(pedidos, "Pedidos", "Domínio", "Registra e consulta pedidos")

        Container(produtos, "Produtos", "Domínio", "Cadastra e remove produtos")

        Container(estoqueSistema, "Estoque", "Domínio", "Controla entradas e saídas")

        ContainerDb(banco, "Banco de Dados", "Dados", "Armazena as informações")
    }

    Rel(vendedor, interface, "Acessa")
    Rel(admin, interface, "Acessa")
    Rel(estoque, interface, "Acessa")

    Rel(interface, pedidos, "Utiliza")
    Rel(interface, produtos, "Utiliza")
    Rel(interface, estoqueSistema, "Utiliza")

    Rel(pedidos, banco, "Salva")
    Rel(produtos, banco, "Salva")
    Rel(estoqueSistema, banco, "Salva")